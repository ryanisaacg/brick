// Counter | 2

extern fn incr_test_counter();

struct X: Resource {
    fn drop(unique self) {
        incr_test_counter();
    }
}


struct Y: Resource {
    fn drop(unique self) {
        incr_test_counter();
        incr_test_counter();
        incr_test_counter();
    }
}

union XorY: Resource {
    x(X),
    y(Y),

    fn drop(unique self) {
        incr_test_counter();
    }
}

let val = XorY.x(X{});
